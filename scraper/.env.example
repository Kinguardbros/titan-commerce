# Required — bearer token that Titan Commerce backend uses to call scraper
# Generate with: openssl rand -hex 32
TITAN_SCRAPER_TOKEN=<paste-64-char-hex>

# Optional — port (defaults 3100 if unset in server.js)
# PORT=3100

# Optional — rate limits on /scrape-amazon (defaults 10/min per-IP, 20/hour global)
# SCRAPER_RATE_LIMIT_PER_IP=10
# SCRAPER_RATE_LIMIT_GLOBAL=20
