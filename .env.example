# Titan Commerce local development env
# Copy to .env.local, fill in real values, do NOT commit .env.local
# See CLAUDE.md Env Vars section for full descriptions

# --- Auth / App ---
APP_PASSWORD=                   # Dashboard master login password (kill-switch fallback, bypasses per-user login). See CLAUDE.md > APP_PASSWORD rotation.
APP_SECRET=                     # Session token HMAC signing key. Required — auth fails closed if unset.
APP_URL=                        # Public app URL (e.g. https://titan-commerce.vercel.app) — webhook callback target
SITE_URL=https://shop-elegancehouse.com
STOREFRONT_URL=                 # DEPRECATED (P1-10, AUDIT-2026-08) — one-deploy-cycle CORS fallback only; per-store origins now live in stores.storefront_origins. Leave empty.

# --- AI / Generation ---
FAL_KEY=                        # fal.ai API key (primary image gen)
HF_CREDENTIALS=your_key_id:your_key_secret   # Higgsfield API key (fallback / video). Format "api_key_id:api_key_secret"
ANTHROPIC_API_KEY=              # Claude API (product optimization, vision, skill gen)

# --- Supabase ---
SUPABASE_URL=https://ercrkgfihqgrbkkqnoqy.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # backend uses this, bypasses RLS
VITE_SUPABASE_URL=https://ercrkgfihqgrbkkqnoqy.supabase.co   # frontend (Vite uses VITE_ prefix)
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_API_URL=                   # leave empty for default (same-origin /api)

# --- Shopify (default/primary store fallback only — most flows use per-store credentials
#     stored in the `stores` table, not env vars; see "Multi-Store Data Isolation" in CLAUDE.md) ---
SHOPIFY_STORE_URL=              # default store (Elegance House)
SHOPIFY_ACCESS_TOKEN=           # default storefront token
SHOPIFY_ADMIN_TOKEN=            # default admin token

# --- Meta Marketing API (awaiting setup — leave empty until credentials exist) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Amazon reviews scraper (separate VPS-hosted service, not part of this app's deploy) ---
AMAZON_SCRAPER_URL=             # e.g. http://<scraper-vps-ip>:3100
AMAZON_SCRAPER_TOKEN=           # shared bearer secret, must match the scraper VPS .env
FEATURE_AMAZON_REVIEWS_SCRAPER= # 'true' to enable the Amazon tab + import/scrape actions, default off
FEATURE_AMAZON_USERSCRIPT=      # 'true' to mark the userscript flow live; also requires FEATURE_AMAZON_REVIEWS_SCRAPER=true
AMAZON_USERSCRIPT_ORIGINS=      # optional comma-separated CORS override, default 'https://www.amazon.com,https://smile.amazon.com'

# --- Monitoring (P1-21, AUDIT-2026-08, Telegram + GitHub Actions replaced Sentry + Better Stack) ---
TELEGRAM_BOT_TOKEN=              # Required for error notifications. Empty = lib/notify.js is a no-op. See Docs/RUNBOOK-monitoring.md (BotFather setup). Also set as a GitHub repo secret for .github/workflows/uptime.yml.
TELEGRAM_CHAT_ID=                # Required for error notifications, paired with TELEGRAM_BOT_TOKEN. Also set as a GitHub repo secret.
CRON_SECRET=                    # bearer token api/cron/detect-events.js checks; Vercel sets this automatically for its own cron invocations
